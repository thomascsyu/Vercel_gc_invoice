# ============================================
# GC-INV API Server Environment Configuration (Example)
# ============================================
# Copy this file to .env and fill in your actual values.
# DO NOT commit .env to version control!

# Database (PostgreSQL)
# PostgreSQL. On the Simple Application Server, use the Compose service
# hostname: postgresql://gc_inv:password@postgres:5432/gc_inv
# POSTGRES_CONNECTION_STRING / POSTGRES_URI / POSTGRES_* override DATABASE_URL when set.
DATABASE_URL="postgresql://username:password@host:5432/database"

# Optional pg pool tuning (defaults are fine for most deployments)
# PG_POOL_MAX=20
# PG_POOL_IDLE_TIMEOUT_MS=30000
# PG_POOL_CONNECT_TIMEOUT_MS=5000
# PG_POOL_KEEPALIVE=true
# PG_POOL_KEEPALIVE_DELAY_MS=10000
# PG_POOL_MAX_LIFETIME_SECONDS=1800

# Server Configuration
PORT=8080
# The Docker image sets NODE_ENV=production. Set it here too if you run Node
# directly on the VM (production security checks stay off when this is unset).
# NODE_ENV=production

# Business timezone for scheduled jobs (quotation reminders 08:00, recurring invoices 06:00).
# The Ubuntu image clock is often UTC. Unset TZ still uses Asia/Hong_Kong inside the app.
# TZ=Asia/Hong_Kong

# Reverse proxies that append X-Forwarded-For. 1 = nginx on this server.
# 2 = a second proxy in front of that nginx.
# TRUST_PROXY_HOPS=1

# Optional: base URL for server-side PDF code to fetch `/api/storage/...` images when
# loopback to PORT is wrong (e.g. PDF job on another host). No trailing slash.
# INTERNAL_IMAGE_FETCH_BASE="http://127.0.0.1:8080"

# JWT Secret (must be at least 16 characters)
JWT_SECRET="your-super-secret-jwt-key-min-16-chars"

# Session Secret (used for cookie signing and OAuth state)
SESSION_SECRET="your-super-secret-session-key-min-16-chars"

# Public App URL (used for redirects and CORS)
PUBLIC_APP_URL="https://yourdomain.com"

# CORS Configuration
CORS_ALLOWED_ORIGINS="https://yourdomain.com,https://app.yourdomain.com"

# ============================================
# Google OAuth Configuration (REQUIRED)
# ============================================
# Get these from Google Cloud Console:
# https://console.cloud.google.com/apis/credentials

GOOGLE_OAUTH_CLIENT_ID="your-client-id.apps.googleusercontent.com"
GOOGLE_OAUTH_CLIENT_SECRET="your-client-secret"
GOOGLE_OAUTH_REDIRECT_URI="https://yourdomain.com/api/auth/google/callback"

# ============================================
# Optional Google OAuth Settings
# ============================================

# Restrict sign-in to a specific Google Workspace domain
# GOOGLE_OAUTH_HOSTED_DOMAIN="yourdomain.com"

# Enable invite-only mode (set to "true" to prevent auto-registration)
# GOOGLE_SIGN_IN_INVITE_ONLY="false"

# ============================================
# Optional Gmail API Configuration
# ============================================
# If unset, the API uses GOOGLE_OAUTH_CLIENT_ID / SECRET and derives the Gmail
# callback from GOOGLE_OAUTH_REDIRECT_URI (…/api/auth/google/callback → …/api/gmail/oauth/callback).
# You must still add the Gmail redirect URI in Google Cloud Console.
# GMAIL_OAUTH_CLIENT_ID=""
# GMAIL_OAUTH_CLIENT_SECRET=""
# GMAIL_OAUTH_REDIRECT_URI=""
# GMAIL_OAUTH_STATE_SECRET=""

# ============================================
# Optional Application Settings
# ============================================

# Quotation reminder days (default: 3)
# QUOTATION_REMINDER_DAYS="3"

# Timezone for scheduled jobs and overdue filters (default business TZ: Asia/Hong_Kong)
# TZ="Asia/Hong_Kong"

# Local/test only: allow JWT fallback when Postgres is down during auth (do not set in production)
# AUTH_DB_FALLBACK="1"

# Force secure cookies (set to "true" for HTTPS)
# FORCE_SECURE_COOKIES="true"

# Google Cloud Storage credentials path
# GOOGLE_APPLICATION_CREDENTIALS="/path/to/service-account.json"

# ============================================
# Object storage (public assets: logos, stamps, payment uploads)
# ============================================
# Comma-separated GCS path prefixes, each "/bucket-name/prefix" (e.g. "/my-bucket/public").
# When unset, the API stores public uploads on local disk (see LOCAL_* below).
# PUBLIC_OBJECT_SEARCH_PATHS="/my-bucket/public"

# Local directory for public uploads when PUBLIC_OBJECT_SEARCH_PATHS is empty.
# Default: .local/public-objects (dev). In Docker, bind-mount a host directory at
# /data and set the paths below. On a bare Ubuntu process, point these at a data
# disk outside the git checkout (for example /var/lib/gc-inv/uploads/...).
# LOCAL_PUBLIC_UPLOAD_DIR="/data/public-objects"

# Set to 1 when uploads live on a host directory. Also auto-detected when /data
# is its own mount, or when the path sits on the Ubuntu root disk (ext4/xfs).
# PERSIST_LOCAL_UPLOADS="1"

# Private bucket prefix for signed uploads (e.g. "/my-bucket/private").
# PRIVATE_OBJECT_DIR="/my-bucket/private"

# Local directory for private uploads when PRIVATE_OBJECT_DIR is empty.
# LOCAL_PRIVATE_UPLOAD_DIR="/data/private-objects"
