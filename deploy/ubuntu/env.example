# Copy to deploy/ubuntu/.env (that file is gitignored). Do not commit secrets.
#
#   cp deploy/ubuntu/env.example deploy/ubuntu/.env

PORT=8080
NODE_ENV=production
TZ=Asia/Hong_Kong

# 1 = nginx on this server terminates TLS (certbot). Use 2 only if a second
# proxy is later placed in front of nginx.
TRUST_PROXY_HOPS=1

# Postgres from `docker compose --profile local-db`. Compose builds DATABASE_URL
# from these values — set POSTGRES_PASSWORD only; do not paste a second copy.
POSTGRES_USER=gc_inv
POSTGRES_PASSWORD=change-me
POSTGRES_DB=gc_inv

# openssl rand -base64 48
JWT_SECRET=replace-with-at-least-32-characters
SESSION_SECRET=replace-with-another-long-random-secret

PUBLIC_APP_URL=https://gcinvoice.cc
GOOGLE_OAUTH_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_OAUTH_CLIENT_SECRET=your-client-secret
GOOGLE_OAUTH_REDIRECT_URI=https://gcinvoice.cc/api/auth/google/callback

# Optional Workspace restriction
# GOOGLE_OAUTH_HOSTED_DOMAIN=gabriel.hk

# Uploads. Compose bind-mounts this host directory at /data.
# This path is on the system disk. A console snapshot is the backup.
# A system reset or image reinstall removes it.
GC_INV_UPLOAD_DIR=/var/lib/gc-inv/uploads
PERSIST_LOCAL_UPLOADS=1
LOCAL_PUBLIC_UPLOAD_DIR=/data/public-objects
LOCAL_PRIVATE_UPLOAD_DIR=/data/private-objects

# Postgres data for the local-db profile. On the system disk unless you attach
# a data disk later and change this path.
GC_INV_PG_DIR=/var/lib/gc-inv/postgres
