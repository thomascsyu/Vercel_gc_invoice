# Gmail Service Account (Domain-wide Delegation)
# Provide the service account email and its private key. NEVER commit real values —
# keep them in your local .env (which is git-ignored) or your host's secret store.
GMAIL_SERVICE_ACCOUNT_EMAIL=your-service-account@your-project.iam.gserviceaccount.com
GMAIL_SERVICE_ACCOUNT_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n<your-private-key>\n-----END PRIVATE KEY-----"

# Optional: Default subject if not specified per-request
# GMAIL_SERVICE_ACCOUNT_SUBJECT=admin@yourdomain.com
